#!/usr/bin/env node
// A stand-in for `npx --yes wrangler@4 ...` that keeps a pretend Cloudflare account in a JSON file
const fs = require('fs');
const STATE = process.env.FAKE_STATE;
const state = JSON.parse(fs.readFileSync(STATE, 'utf8'));
const argv = process.argv.slice(2);
if (argv[0] !== '--yes' || argv[1] !== 'wrangler@4') { console.error('unexpected npx call ' + argv.join(' ')); process.exit(9); }
const cmd = argv.slice(2);
state.calls.push(cmd.join(' '));
const save = () => fs.writeFileSync(STATE, JSON.stringify(state, null, 2));
const done = (code, out = '', err = '') => { save(); if (out) process.stdout.write(out); if (err) process.stderr.write(err); process.exit(code); };
const needLogin = () => { if (!state.loggedIn) done(1, '', '✘ [ERROR] You are not authenticated. Please run `wrangler login`.\n'); };
const flag = name => { const i = cmd.indexOf(name); return i >= 0 ? cmd[i + 1] : undefined; };
const key = cmd.slice(0, 2).join(' ');

if (cmd[0] === '--version') {
  if (state.npmBroken) done(1, '', 'npm error code ECONNRESET\nnpm error network aborted\n');
  done(0, ' ⛅️ wrangler 4.159.0\n');
}
if (cmd[0] === 'whoami') {
  if (!state.loggedIn) done(1, '', 'You are not authenticated.\n');
  done(0, JSON.stringify({ loggedIn: true, authType: 'OAuth Token', accounts: [{ id: 'acc1', name: 'spotikyhq' }] }) + '\n');
}
if (cmd[0] === 'login' && cmd.includes('--browser=false')) {
  // Prints the link like Wrangler, then "the person finishes signing in" a moment later
  save();
  process.stdout.write('Attempting to login via OAuth...\n');
  process.stdout.write('Visit this link to authenticate: https://dash.cloudflare.com/oauth2/auth?response_type=code&client_id=54d11594&redirect_uri=http%3A%2F%2Flocalhost%3A8976%2Foauth%2Fcallback&scope=account%3Aread%20offline_access&state=Zx9&code_challenge=abc&code_challenge_method=S256\n');
  setTimeout(() => {
    const now = JSON.parse(fs.readFileSync(STATE, 'utf8'));
    now.loggedIn = true;
    fs.writeFileSync(STATE, JSON.stringify(now, null, 2));
    process.stdout.write('Successfully logged in.\n');
    process.exit(0);
  }, 500);
  return;
}
if (cmd[0] === 'login') { state.loggedIn = true; done(0, 'Successfully logged in.\n'); }
if (key === 'd1 list') {
  needLogin();
  if (state.manyAccounts) done(1, '', '✘ [ERROR] More than one account available but unable to select one in non-interactive mode.\n');
  // A notice with brackets before the JSON, like Wrangler's warnings, to test the reading
  done(0, '▲ [WARNING] Proxy environment variables detected.\n' + JSON.stringify(state.dbs, null, 2) + '\n');
}
if (key === 'd1 create') {
  needLogin();
  state.dbs.push({ uuid: '7c1d0f8e-0b5a-4e6f-9a1b-2c3d4e5f6a7b', name: cmd[2], created_at: '2026-11-09', version: 'production' });
  done(0, `✅ Successfully created DB '${cmd[2]}'\n{\n  "d1_databases": [ { "binding": "spotiky", "database_name": "spotiky", "database_id": "7c1d0f8e-..." } ]\n}\n`);
}
if (cmd[0] === 'deploy') {
  needLogin();
  const config = fs.readFileSync('wrangler.jsonc', 'utf8');
  const id = (config.match(/"database_id"\s*:\s*"([^"]*)"/) || [])[1];
  if (!/^[0-9a-f-]{36}$/.test(id || '')) done(1, '', `✘ [ERROR] Invalid database_id "${id}"\n`);
  state.deployedWith = id;
  state.deploys = (state.deploys || 0) + 1;
  done(0, 'Uploaded spotiky-preview\nDeployed spotiky-preview\n');
}
if (key === 'secret list') {
  needLogin();
  if (flag('--name') !== 'spotiky-preview' || flag('--format') !== 'json') done(1, '', 'bad flags\n');
  done(0, JSON.stringify(Object.keys(state.secrets).map(name => ({ name, type: 'secret_text' })), null, '  ') + '\n');
}
if (key === 'secret put') {
  needLogin();
  if (flag('--name') !== 'spotiky-preview') done(1, '', 'bad flags\n');
  const value = fs.readFileSync(0, 'utf8');
  state.secrets[cmd[2]] = value;
  done(0, `✨ Success! Uploaded secret ${cmd[2]}\n`);
}
done(9, '', 'fake wrangler: unknown command ' + cmd.join(' ') + '\n');
